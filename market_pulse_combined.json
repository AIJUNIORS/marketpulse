async function safeFetchJson(path){try{const response=await fetch(path,{cache:"no-store"});if(!response.ok)throw new Error(`${response.status} ${response.statusText}`);return await response.json();}catch(err){console.warn(`Could not load ${path}`,err);return null;}}
async function loadMarketPulseData(){const data=await safeFetchJson(CONFIG.mainDataPath);if(!data){document.getElementById("app").innerHTML=`<div class="empty">Could not load data/market_pulse_combined.json. Make sure backend synced the file into the frontend data folder.</div>`;return;}state.data=data;state.validation=await safeFetchJson(CONFIG.validationPath);state.lastUpdated=await safeFetchJson(CONFIG.lastUpdatedPath);populateControls(data);renderStatus();}
function populateControls(data){const groupSelect=document.getElementById("groupSelect");const sectorSelect=document.getElementById("sectorSelect");groupSelect.querySelectorAll("option:not(:first-child)").forEach(o=>o.remove());sectorSelect.querySelectorAll("option:not(:first-child)").forEach(o=>o.remove());const sectors=new Set();data.groups.forEach(group=>{const option=document.createElement("option");option.value=group.market_group;option.textContent=`${group.display_name||group.market_group} (${(group.items||[]).length})`;groupSelect.appendChild(option);(group.items||[]).forEach(item=>{if(item.sector_group)sectors.add(item.sector_group);});});[...sectors].sort().forEach(sector=>{const option=document.createElement("option");option.value=sector;option.textContent=sector;sectorSelect.appendChild(option);});}
function renderStatus(){const d=state.data;const validationStatus=state.validation?.status||"unknown";const eastTime=d.source_files?.east_generated_at||"-";const westTime=d.source_files?.west_generated_at||"-";document.getElementById("statusBar").innerHTML=`Generated: ${fmtDate(d.generated_at)}<br>East: ${fmtDate(eastTime)} | West: ${fmtDate(westTime)}<br>Validation: ${String(validationStatus).toUpperCase()} | Price Source: Close`;}
