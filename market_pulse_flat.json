function initializeControls(){document.querySelectorAll("[data-tf]").forEach(btn=>{btn.addEventListener("click",()=>{state.selectedTimeframe=btn.dataset.tf;document.querySelectorAll("[data-tf]").forEach(b=>b.classList.remove("active"));btn.classList.add("active");renderApp();});});document.getElementById("groupSelect").addEventListener("change",e=>{state.selectedGroup=e.target.value;renderApp();});document.getElementById("sectorSelect").addEventListener("change",e=>{state.selectedSector=e.target.value;renderApp();});document.getElementById("signalSelect").addEventListener("change",e=>{state.selectedSignal=e.target.value;renderApp();});document.getElementById("searchBox").addEventListener("input",e=>{state.searchText=e.target.value;renderApp();});document.querySelectorAll("[data-tab]").forEach(btn=>{btn.addEventListener("click",()=>{state.activeTab=btn.dataset.tab;document.querySelectorAll("[data-tab]").forEach(b=>b.classList.remove("active"));btn.classList.add("active");renderApp();});});}
function renderApp(){renderSummaryStrip();const app=document.getElementById("app");if(!state.data)return;if(state.activeTab==="market-pulse")app.innerHTML=renderMarketPulse();if(state.activeTab==="returns")app.innerHTML=renderReturns();if(state.activeTab==="support-zones")app.innerHTML=renderSupportZones();if(state.activeTab==="group-comparison")app.innerHTML=renderGroupComparison();if(state.activeTab==="data-health")app.innerHTML=renderDataHealth();if(state.activeTab==="technical-analysis")app.innerHTML=renderTechnicalAnalysis();}
function renderSummaryStrip(){if(!state.data)return;const items=getAllItems();const ok=items.filter(i=>i.data_status==="ok").length;const tf=state.selectedTimeframe;const riskOn=items.filter(i=>i.signals?.[tf]?.combined_signal==="Risk On").length;const buy=items.filter(i=>["Good Buy","Better Buy","Best Buy"].includes(i.signals?.[tf]?.combined_signal)).length;document.getElementById("summaryStrip").innerHTML=`<div class="summary-card"><div class="summary-label">Universe</div><div class="summary-value">${state.data.universe_count||items.length}</div></div><div class="summary-card"><div class="summary-label">Groups</div><div class="summary-value">${state.data.group_count||state.data.groups.length}</div></div><div class="summary-card"><div class="summary-label">${tf} Risk On</div><div class="summary-value">${riskOn}</div></div><div class="summary-card"><div class="summary-label">${tf} Buy Zones</div><div class="summary-value">${buy}</div></div><div class="summary-card"><div class="summary-label">Data OK</div><div class="summary-value">${ok}</div></div>`;}
function renderMarketPulse(){const groups=getVisibleGroups();if(groups.length===0)return `<div class="empty">No instruments match current filters.</div>`;return groups.map(group=>{const tf=state.selectedTimeframe;const groupSignal=group.group_signals?.[tf]||"-";return `<section class="group-card"><div class="group-header"><div><div class="group-title">${group.display_name||group.market_group}</div><div class="group-meta">Benchmark: ${group.benchmark_symbol} | Geography: ${group.geography_bucket} | Items: ${group.items.length}</div></div><div class="group-signal">${tf.toUpperCase()} ${signalPill(groupSignal)}</div></div><div class="table-wrap"><table class="instrument-table"><thead><tr><th>Symbol</th><th>Name</th><th>Sector</th><th>Close</th><th>${tf} Return</th><th>Technical</th><th>Combined</th></tr></thead><tbody>${group.items.map(renderMarketPulseRow).join("")}</tbody></table></div></section>`;}).join("");}
function renderMarketPulseRow(item){const tf=state.selectedTimeframe;const ret=item.returns?.[tf];const tech=item.signals?.[tf]?.technical_signal||item.technicals?.[tf]?.signal||"-";const combined=item.signals?.[tf]?.combined_signal||"Watch";return `<tr class="${item.role==="benchmark"?"benchmark-row":""}"><td data-label="Symbol">${item.symbol}<br><span class="role-pill">${item.role}</span></td><td data-label="Name">${item.name||"-"}</td><td data-label="Sector">${item.sector_group||"-"}<br><span class="small">${item.subsector||""}</span></td><td data-label="Close">${fmtPrice(item.last_close,item.currency)}<br><span class="small">${item.price_label||"Close"} | ${item.last_date||"-"}</span></td><td data-label="Return" class="${pctClass(ret)}">${fmtPct(ret)}</td><td data-label="Technical">${tech}</td><td data-label="Combined">${signalPill(combined)}</td></tr>`;}
function renderReturns(){const items=filterItems(getAllItems());return tableCard("Returns",`<tr><th>Symbol</th><th>Group</th><th>Close</th><th>Daily</th><th>Weekly</th><th>Monthly</th><th>YTD</th><th>1M</th><th>3M</th><th>6M</th><th>1Y</th><th>Drawdown</th></tr>${items.map(i=>`<tr class="${i.role==="benchmark"?"benchmark-row":""}"><td>${i.symbol}</td><td>${i.market_group}</td><td>${fmtPrice(i.last_close,i.currency)}</td><td class="${pctClass(i.returns?.daily)}">${fmtPct(i.returns?.daily)}</td><td class="${pctClass(i.returns?.weekly)}">${fmtPct(i.returns?.weekly)}</td><td class="${pctClass(i.returns?.monthly)}">${fmtPct(i.returns?.monthly)}</td><td class="${pctClass(i.returns?.ytd)}">${fmtPct(i.returns?.ytd)}</td><td class="${pctClass(i.returns?.r1m)}">${fmtPct(i.returns?.r1m)}</td><td class="${pctClass(i.returns?.r3m)}">${fmtPct(i.returns?.r3m)}</td><td class="${pctClass(i.returns?.r6m)}">${fmtPct(i.returns?.r6m)}</td><td class="${pctClass(i.returns?.r1y)}">${fmtPct(i.returns?.r1y)}</td><td class="${pctClass(i.drawdown?.current_drawdown_pct)}">${fmtPct(i.drawdown?.current_drawdown_pct)}</td></tr>`).join("")}`);}
function renderSupportZones(){const tf=state.selectedTimeframe;const items=filterItems(getAllItems());return tableCard(`Support Zones — ${tf.toUpperCase()}`,`<tr><th>Symbol</th><th>Group</th><th>Close</th><th>Pivot</th><th>BC</th><th>TC</th><th>S1</th><th>S2</th><th>R1</th><th>R2</th><th>Dist S1</th><th>Dist S2</th><th>Signal</th></tr>${items.map(i=>{const t=i.technicals?.[tf]||{};const signal=i.signals?.[tf]?.combined_signal||"Watch";return `<tr class="${i.role==="benchmark"?"benchmark-row":""}"><td>${i.symbol}</td><td>${i.market_group}</td><td>${fmtPrice(i.last_close,i.currency)}</td><td>${fmtNum(t.pivot)}</td><td>${fmtNum(t.bc)}</td><td>${fmtNum(t.tc)}</td><td>${fmtNum(t.s1)}</td><td>${fmtNum(t.s2)}</td><td>${fmtNum(t.r1)}</td><td>${fmtNum(t.r2)}</td><td>${fmtPct(t.distance_to_s1_pct)}</td><td>${fmtPct(t.distance_to_s2_pct)}</td><td>${signalPill(signal)}</td></tr>`;}).join("")}`);}
function renderGroupComparison(){const tf=state.selectedTimeframe;return tableCard("Group Comparison",`<tr><th>Group</th><th>Benchmark</th><th>Weekly</th><th>Monthly</th><th>Annual</th><th>Items</th><th>${tf} Benchmark Return</th></tr>${state.data.groups.map(g=>{const benchmark=(g.items||[]).find(i=>i.symbol===g.benchmark_symbol)||(g.items||[])[0]||{};return `<tr><td>${g.display_name||g.market_group}</td><td>${g.benchmark_symbol}</td><td>${signalPill(g.group_signals?.weekly)}</td><td>${signalPill(g.group_signals?.monthly)}</td><td>${signalPill(g.group_signals?.annual)}</td><td>${(g.items||[]).length}</td><td class="${pctClass(benchmark.returns?.[tf])}">${fmtPct(benchmark.returns?.[tf])}</td></tr>`;}).join("")}`);}
function renderTechnicalAnalysis(){const tf=state.selectedTimeframe;const items=filterItems(getAllItems());return tableCard(`Technical Analysis — ${tf.toUpperCase()}`,`<tr><th>Symbol</th><th>Group</th><th>Close</th><th>Pivot</th><th>BC</th><th>TC</th><th>S1</th><th>S2</th><th>R1</th><th>R2</th><th>Position</th><th>Technical Signal</th></tr>${items.map(i=>{const t=i.technicals?.[tf]||{};const p=t.price_position||{};const position=p.inside_cpr?"Inside CPR":p.above_cpr?"Above CPR":p.below_cpr?"Below CPR":p.above_pivot?"Above Pivot":"Below Pivot";return `<tr class="${i.role==="benchmark"?"benchmark-row":""}"><td>${i.symbol}</td><td>${i.market_group}</td><td>${fmtPrice(i.last_close,i.currency)}</td><td>${fmtNum(t.pivot)}</td><td>${fmtNum(t.bc)}</td><td>${fmtNum(t.tc)}</td><td>${fmtNum(t.s1)}</td><td>${fmtNum(t.s2)}</td><td>${fmtNum(t.r1)}</td><td>${fmtNum(t.r2)}</td><td>${position}</td><td>${t.signal||"-"}</td></tr>`;}).join("")}`);}
function renderDataHealth(){const d=state.data;const validation=state.validation||{};return `<section class="health-box"><h2>Data Health</h2><br><div class="details-grid"><div class="metric"><div class="metric-label">Universe</div><div class="metric-value">${d.universe_count}</div></div><div class="metric"><div class="metric-label">Groups</div><div class="metric-value">${d.group_count}</div></div><div class="metric"><div class="metric-label">Missing Groups</div><div class="metric-value">${(d.missing_groups||[]).length}</div></div><div class="metric"><div class="metric-label">Validation</div><div class="metric-value">${validation.status||"unknown"}</div></div></div><br><h3>Source Files</h3><pre>${JSON.stringify(d.source_files||{},null,2)}</pre><br><h3>Validation Report</h3><pre>${JSON.stringify(validation,null,2)}</pre></section>`;}
function tableCard(title,rows){return `<section class="group-card"><div class="group-header"><div class="group-title">${title}</div></div><div class="table-wrap"><table class="instrument-table"><tbody>${rows}</tbody></table></div></section>`;}
